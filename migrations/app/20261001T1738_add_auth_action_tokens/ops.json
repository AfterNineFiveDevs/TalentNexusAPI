        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"authActionToken\"",
        "sql": "CREATE TABLE \"public\".\"authActionToken\" (\n  \"consumedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"purpose\" text NOT NULL,\n  \"tokenHash\" text NOT NULL,\n  \"userId\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"authActionToken_purpose_check_325330e4\" CHECK (\"purpose\" IN ('EMAIL_VERIFICATION', 'PASSWORD_RESET'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"authActionToken\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"authActionToken\""
        ]
      }
    ]
  },
