# Copy to api.env on the Swarm manager and fill in the staging values.
# Keep the existing staging JWT and MFA keys when redeploying.
DATABASE_URL="postgresql://user:password@database-host:5432/database"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
ADMIN_MFA_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
CRAWLER_WORKER_TOKEN=replace-with-the-same-secret-in-crawler.env

# These are browser frontend URLs and origins.
WEB_APP_URL=https://your-staging-web-host.example.com
ADMIN_APP_URL=https://your-staging-admin-host.example.com
CORS_ORIGIN=https://your-staging-web-host.example.com,https://your-staging-admin-host.example.com
# For local frontend development, enable STAGING_ALLOW_LOCALHOST and use
# http://localhost:3000 for the web URL and http://localhost:5173 for the admin URL.
# STAGING_ALLOW_LOCALHOST=true
GOOGLE_CLIENT_IDS=replace-with-your-staging-client-id.apps.googleusercontent.com

EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-staging-brevo-key
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME="Talent Nexus"
