// use prisma-8

model User {
  id        Uuid      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  role      ROLE @default(TALENT)
  signUpMethod SignUpMethod @default(EMAIL)
  resetPasswordToken String?
  resetPasswordTokenExpiry DateTime?
  verificationToken String?
  verifiedAt DateTime?
  profile   Profile?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Profile {
  id        Uuid      @id @default(autoincrement())
  photo     String?
  phone     String?
  bio       String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "profile_user_id_fkey")
  userId    Uuid
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Cv {
  id        Uuid      @id @default(autoincrement())
  file      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "cv_user_id_fkey")
  userId    Uuid
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum Role {
  TALENT
  RECRUITER
  ADMIN
}

enum SignUpMethod {
  EMAIL
  GOOGLE
  LinkedIn
}