// use prisma-8
model CrawlerSource {
  sourceId String @id
  enabled Boolean @default(false)
  schedule String
  timezone String @default("Asia/Yangon")
  pageLimit Int @default(2)
  version Int @default(0)
  nextDueAt TimestamptzString?
  runs CrawlerRun[]
  @@check(expression: "version >= 0 AND \"pageLimit\" BETWEEN 1 AND 100", name: "crawler_source_bounds")
}
model CrawlerRun {
  id Uuid @id @default(uuid())
  sourceId String
  source CrawlerSource @relation(fields: [sourceId], references: [sourceId], onDelete: Restrict)
  trigger String
  status String
  configuration String
  workerId String?
  leaseHash String?
  leaseExpiresAt TimestamptzString?
  deadlineAt TimestamptzString?
  queuedAt TimestamptzString @default(now())
  startedAt TimestamptzString?
  finishedAt TimestamptzString?
  counts String
  failures String @default("[]")
  batches CrawlerBatch[]
  @@index([sourceId, status])
  @@index([status, queuedAt])
  @@check(expression: "status IN ('QUEUED','RUNNING','SUCCEEDED','PARTIAL','FAILED','ABANDONED')", name: "crawler_run_status")
}
model CrawlerBatch {
  id Uuid @id @default(uuid())
  runId Uuid
  run CrawlerRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  batchId Uuid
  payloadHash String
  acknowledgment String
  @@unique([runId, batchId])
}
model CrawlerWorker {
  workerId String @id
  sourceIds String
  lastSeenAt TimestamptzString
}
model User {
  id                       Uuid                       @id @default(uuid())
  email                    String                     @unique
  password                 String?
  name                     String?
  role                     Role                       @default(TALENT)
  termAccepted             Boolean
  signUpMethod             SignUpMethod               @default(EMAIL)
  verifiedAt               TimestamptzString?
  categorySubscriptions    CategorySubscription[]
  profile                  Profile?
  authSessions             AuthSession[]
  authActionTokens         AuthActionToken[]
  authIdentities           AuthIdentity[]
  createdAt                TimestamptzString          @default(now())
  updatedAt                temporal.updatedAtString()
}

model AuthIdentity {
  id              Uuid         @id @default(uuid())
  user            User         @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "auth_identity_user_id_fkey")
  userId          Uuid
  provider        AuthProvider
  providerSubject String
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model AuthActionToken {
  id         Uuid                   @id @default(uuid())
  user       User                   @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "auth_action_token_user_id_fkey")
  userId     Uuid
  tokenHash  String                 @unique
  purpose    AuthActionTokenPurpose
  expiresAt  TimestamptzString
  consumedAt TimestamptzString?
  createdAt  TimestamptzString      @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthSession {
  id                 Uuid                     @id @default(uuid())
  user               User                     @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "auth_session_user_id_fkey")
  userId             Uuid
  refreshTokenHash   String                   @unique
  expiresAt          TimestamptzString
  lastRotatedAt      TimestamptzString        @default(now())
  revokedAt          TimestamptzString?
  revocationReason   SessionRevocationReason?
  purpose            String                   @default("USER")
  mfaVerifiedAt      TimestamptzString?
  absoluteExpiresAt  TimestamptzString?
  createdAt          TimestamptzString        @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id        Uuid                       @id @default(uuid())
  photo     String?
  phone     String?
  bio       String?
  user      User                       @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "profile_user_id_fkey")
  userId    Uuid                       @unique
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Cv {
  id        Uuid                       @id @default(uuid())
  file      String
  user      User                       @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "cv_user_id_fkey")
  userId    Uuid
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Job {
  categoryId Uuid?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  id             Uuid      @id @default(uuid())
  sourceId       String
  externalId     String
  sourceUrl      String

  title          String
  companyName    String
  description    String
  location       String
  applicationUrl String[]

  status         JobStatus @default(PENDING)

  version             Int @default(0)
  adminEditedAt       TimestamptzString?
  deletedAt           TimestamptzString?
  lastAdminAction     JobAdminAction?
  lastAdminActionById Uuid?
  lastAdminActionBy   User? @relation(fields: [lastAdminActionById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "job_last_admin_action_by_fkey")
  lastAdminActionAt   TimestamptzString?
  lastAdminActionNote String?

  reviewedById   Uuid?
  reviewedBy     User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedAt     TimestamptzString?
  reviewNote     String?

  publishedAt    TimestamptzString?
  closedAt       TimestamptzString?
  lastSeenAt     TimestamptzString @default(now())
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([sourceId, externalId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([deletedAt, status, createdAt])
  @@check(expression: "version >= 0", name: "job_version_nonnegative")
}

enum JobAdminAction {
  @@type("pg/text@1")

  CREATE
  EDIT
  PUBLISH
  REJECT
  CLOSE
  REOPEN
  DELETE
  RESTORE
}

enum Role {
  @@type("pg/text@1")

  TALENT
  RECRUITER
  ADMIN
}

enum SignUpMethod {
  @@type("pg/text@1")

  EMAIL
  GOOGLE
  LinkedIn
}

enum SessionRevocationReason {
  @@type("pg/text@1")

  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE
}

enum AuthActionTokenPurpose {
  @@type("pg/text@1")

  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthProvider {
  @@type("pg/text@1")

  GOOGLE
}

enum JobStatus {
  @@type("pg/text@1")

  PENDING
  PUBLISHED
  REJECTED
  CLOSED
}

model AdminMembership {
  userId Uuid @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalRole Role @default(TALENT)
  state String @default("ONBOARDING")
  secretCiphertext String?
  lastTotpStep Int @default(0)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@check(expression: "state IN ('ONBOARDING', 'ACTIVE', 'DISABLED')", name: "admin_membership_state")
}
model AdminInvitation {
  id Uuid @id @default(uuid())
  email String @unique
  name String
  tokenHash String @unique
  state String @default("PENDING")
  userId Uuid?
  createdById Uuid?
  expiresAt TimestamptzString
  lastSentAt TimestamptzString @default(now())
  createdAt TimestamptzString @default(now())
  @@check(expression: "state IN ('PENDING', 'ONBOARDING', 'ACCEPTED', 'REVOKED')", name: "admin_invitation_state")
}
model AdminChallenge {
  id Uuid @id @default(uuid())
  tokenHash String @unique
  userId Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  attempts Int @default(0)
  secretCiphertext String?
  expiresAt TimestamptzString
  consumedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  @@index([userId])
  @@check(expression: "purpose IN ('ENROLL', 'VERIFY')", name: "admin_challenge_purpose")
}
model AdminRecoveryCode {
  id Uuid @id @default(uuid())
  userId Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique
  consumedAt TimestamptzString?
  @@index([userId])
}
model AdminAuthAttempt {
  key String @id
  attempts Int @default(0)
  windowStartedAt TimestamptzString @default(now())
}

model Category {
  id Uuid @id @default(uuid())
  name String
  normalizedName String @unique
  description String @default("")
  status CategoryStatus @default(ACTIVE)
  version Int @default(0)
  jobs Job[]
  subscriptions CategorySubscription[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([status, name])
  @@check(expression: "version >= 0", name: "category_version_nonnegative")
}
model CategorySubscription {
  id Uuid @id @default(uuid())
  userId Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt TimestamptzString @default(now())
  @@unique([userId, categoryId])
  @@index([categoryId, createdAt])
}
enum CategoryStatus {
  @@type("pg/text@1")
  ACTIVE
  HIDDEN
  ARCHIVED
}
