# Copy this file to `.env` and replace all placeholders.
# `staging` and `production` require CORS_ORIGIN and a JWT secret of 32+ characters.
ENVIRONMENT=development
# Required for staging and production. Use comma-separated origins without trailing slashes.
# CORS_ORIGIN="https://staging.example.com,https://app.example.com"
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=15m
# Seven-day sliding refresh session.
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_COOKIE_NAME=talent_nexus_refresh
# Use `console` locally. Staging and production require `brevo`.
EMAIL_PROVIDER=console
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME="Talent Nexus"
WEB_APP_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
AUTH_ACTION_TOKEN_COOLDOWN_SECONDS=60
PORT=8000
LOG_LEVEL=log
